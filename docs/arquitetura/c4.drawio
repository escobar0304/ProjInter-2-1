<mxfile host="drawio" version="24.0.0"><diagram id="c4-1" name="C4 nível 1: contexto"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="guest" value="&lt;b&gt;Guest&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Visitante sem sessão iniciada." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="230" height="120" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Registered User&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Jovem do 3.º ciclo ou do secundário, com conta." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="40" width="230" height="120" as="geometry"/></mxCell><mxCell id="manager" value="&lt;b&gt;Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Gestor de conteúdos (backoffice)." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="230" height="120" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b&gt;Administrator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Acesso total ao sistema." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="910" y="40" width="230" height="120" as="geometry"/></mxCell><mxCell id="system" value="&lt;b&gt;Plataforma de Literacia em Saúde&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema de software]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Recursos formativos, questionários, badges, certificados, biblioteca virtual e indicadores." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="340" width="420" height="150" as="geometry"/></mxCell><mxCell id="guardian" value="&lt;b&gt;Guardian&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Encarregado de educação de um menor. Não tem conta." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="260" height="120" as="geometry"/></mxCell><mxCell id="email" value="&lt;b&gt;Email Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo: SMTP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Entrega os emails enviados pela plataforma." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="570" width="280" height="120" as="geometry"/></mxCell><mxCell id="e0" value="Consulta o conteúdo público e regista-se" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="guest" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Inscreve-se, vê recursos e responde a questionários" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="user" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Gere conteúdos e consulta indicadores" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="manager" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Gere contas, perfis e permissões" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="admin" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Aceita, recusa ou revoga o consentimento (link)" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="guardian" target="system"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Envia emails de confirmação, consentimento e recuperação" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="system" target="email"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Entrega o pedido de consentimento" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="email" target="guardian"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c4-2" name="C4 nível 2: contentores"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b" value="Plataforma de Literacia em Saúde [Sistema de software]" style="rounded=1;arcSize=2;fillColor=none;dashed=1;strokeColor=#444444;verticalAlign=bottom;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="1260" height="690" as="geometry"/></mxCell><mxCell id="users" value="&lt;b&gt;Utilizadores&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Guest, Registered User, Manager e Administrator." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="230" y="30" width="300" height="120" as="geometry"/></mxCell><mxCell id="guardian" value="&lt;b&gt;Guardian&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Pessoa]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Encarregado de educação de um menor." style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="30" width="280" height="120" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Aplicação web (SPA)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contentor: React, no browser]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Interface do frontoffice e do backoffice." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="270" width="320" height="140" as="geometry"/></mxCell><mxCell id="web" value="&lt;b&gt;Servidor web&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contentor: Nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Entrega a SPA, encaminha /api para a API e envia os ficheiros." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="140" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contentor: Python, Flask]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Regras de negócio, autenticação e permissões. API REST em JSON." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="560" width="320" height="140" as="geometry"/></mxCell><mxCell id="db" value="&lt;b&gt;Base de dados&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Contentor: PostgreSQL 18]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Utilizadores, recursos, respostas e indicadores." style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="560" width="220" height="140" as="geometry"/></mxCell><mxCell id="files" value="&lt;b&gt;Ficheiros multimédia&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Volume]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Imagens, PDF, vídeos e certificados." style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="320" height="90" as="geometry"/></mxCell><mxCell id="email" value="&lt;b&gt;Email Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;[Sistema externo: SMTP]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Entrega os emails." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#999999;strokeColor=#8a8a8a;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1100" y="940" width="280" height="110" as="geometry"/></mxCell><mxCell id="e0" value="Usa [HTTPS]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="users" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="Abre o link do email [HTTPS]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="guardian" target="spa"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="Pedidos da SPA, /api e ficheiros [HTTPS]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="spa" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="Encaminha /api [HTTP]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="web" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="Lê e escreve [SQL]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="Guarda e valida o acesso" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="api" target="files"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Lê e envia [X-Accel-Redirect]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="web" target="files"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Envia emails [SMTP]" style="endArrow=block;endFill=1;dashed=1;html=1;rounded=0;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#555555;" edge="1" parent="1" source="api" target="email"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
